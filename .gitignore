# Package files are published on the download server, not here. The records,
# license texts and catalog drafts are kept.
pilot/**
!pilot/**/
!pilot/**/RECORD.md
!pilot/**/LICENSE.TXT
packages/**
!packages/**/
!packages/**/RECORD.md
!packages/**/LICENSE.TXT
!packages/**/ENTRY.TXT

# Copies of other people's web pages, fetched by the import scripts.
research/import/cache/

# Never commit a private key or stored credentials.
*.pem
!keys/*.pub.pem
!client/vendor/cacert/cacert.pem
*.dpapi
*.key

# Build output
client/build/out/

# Made by assemble-catalog.ps1 for uploading; holds local paths.
catalog/UPLOAD.CSV

# Setup program made by build.ps1 -Iscc
client/dist/

